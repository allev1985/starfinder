# =============================================================================
# LOCAL DEVELOPMENT (using `supabase start` with Docker)
# Run `supabase start` then `npx supabase status` to get these values.
# =============================================================================

# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase status`>
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# =============================================================================
# REMOTE (Supabase cloud project — for production or dev without Docker)
# Found in Supabase Dashboard → Project Settings → API
# =============================================================================

# NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from Supabase Dashboard → API>

# Database connection string (choose one):
#
# Direct connection (port 5432) — for local dev or scripts:
#   Found in Dashboard → Project Settings → Database → Connection string → URI
#   DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Connection pooler (port 6543) — required for Vercel / serverless:
#   Found in Dashboard → Project Settings → Database → Connection pooling → Connection string
#   DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# =============================================================================
# Active values (copy from a section above and fill in)
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
