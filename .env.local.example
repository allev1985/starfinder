# Database connection string (PostgreSQL via Supabase)
#
# For LOCAL DEVELOPMENT (direct connection, port 5432):
# Found in Supabase Dashboard → Project Settings → Database → Connection string → URI
#
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# For PRODUCTION / SERVERLESS (connection pooler, port 6543):
# Found in Supabase Dashboard → Project Settings → Database → Connection pooling → Connection string
# Required for Vercel, serverless functions, and any environment with many concurrent connections.
#
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=
